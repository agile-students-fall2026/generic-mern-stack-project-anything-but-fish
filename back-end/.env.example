# Set MONGODB_URI and JWT_SECRET together for accounts and saved progress.
# Leave both blank for local guest chat only.
MONGODB_URI=
MONGODB_DB_NAME=anything_but_fish
JWT_SECRET=

AUTH_SESSION_COOKIE=abf_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=0
PORT=8000

# OpenAI requests are made by the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini